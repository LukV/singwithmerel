{
  "name": "singwithmerel",
  "version": "0.1.0-rc.0",
  "private": true,
  "description": "Merel teaches anyone to sing a scale and recognise notes by ear, with solfege.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
